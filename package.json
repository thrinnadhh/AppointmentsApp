{
  "name": "appointments-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hyperlocal Multi-Vertical Booking Platform (MVP v1)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:agents": "python3 .agents/scripts/validate_kit.py",
    "check:legal": "node scripts/check-legal-placeholders.js",
    "check:antigravity": "python3 .agents/scripts/checklist.py .",
    "test:antigravity": "python3 -m unittest discover -s .agents/scripts/tests -v",
    "status": "python3 .agents/scripts/session_manager.py status .",
    "dev:merchant": "pnpm --filter @appointments/merchant-web dev",
    "dev:mobile": "pnpm --filter @appointments/customer-mobile start",
    "db:wipe": "node scripts/wipe-test-data.mjs",
    "db:seed": "node scripts/seed-hospital-test-data.mjs",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:e2e": "playwright test",
    "test:mobile": "node tests/mobile/customer-mobile-android.test.mjs",
    "test": "pnpm test:e2e",
    "test:validation": "node --test tests/scripts/test-validation.mjs",
    "test:security": "node --test tests/scripts/test-security.mjs tests/scripts/test-routes.mjs tests/scripts/test-validation.mjs"
  },
  "keywords": [
    "appointments",
    "hyperlocal",
    "booking",
    "supabase",
    "react-native",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pg": "^8.23.1",
    "webdriverio": "^9.32.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "minimatch@3>brace-expansion": ">=1.1.21",
      "brace-expansion": ">=5.0.12",
      "uuid": ">=11.1.1",
      "braces": ">=3.0.3",
      "node-forge": ">=1.4.1",
      "shell-quote": ">=1.11.0",
      "compression": ">=1.8.2",
      "source-map-js": ">=1.2.2",
      "sharp": ">=0.35.5",
      "next": "15.5.28",
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5",
      "zod": ">=3.24.0"
    },
    "patchedDependencies": {
      "expo-notifications@58.1.6": "patches/expo-notifications@58.1.6.patch"
    }
  }
}
