# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only — never prefix with NEXT_PUBLIC_, or it gets bundled into client JS.
# Required by webhook and cron routes that must bypass RLS as a trusted write.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay API Credentials
# Used for server-side order generation, cryptographic signature verification, and refunds.
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Required for the payment webhook to verify Razorpay's signature.
# The webhook refuses all requests if this is unset in production.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Free-for-dev Integrations (Optional — defaults to graceful in-memory fallbacks)
# Upstash Serverless Redis (10,000 commands/day free on upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry Crash & Error Radar (5,000 errors/month free on sentry.io)
SENTRY_DSN=https://publickey@o123456.ingest.sentry.io/123456
NEXT_PUBLIC_SENTRY_DSN=https://publickey@o123456.ingest.sentry.io/123456

# Cloudflare R2 Zero-Egress Storage (10 GB free on cloudflare.com)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=appointments-assets
R2_PUBLIC_DOMAIN=https://assets.yourdomain.com
