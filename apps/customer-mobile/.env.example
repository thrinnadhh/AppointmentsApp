# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Deployed merchant-web backend URL — used for reschedule and payment order creation.
# Do not use localhost in production mobile builds.
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-backend.example.com

# Razorpay Publishable Key ID for client checkout initialization
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Cashfree Environment ('SANDBOX' | 'PRODUCTION')
EXPO_PUBLIC_CASHFREE_ENV=SANDBOX

# EAS Project ID (UUID generated via `npx eas-cli init`)
EXPO_PUBLIC_EAS_PROJECT_ID=REPLACE_ME_EAS_PROJECT_UUID

# Grievance Officer Configuration (DPDPA 2023 §13 — must be replaced before build)
EXPO_PUBLIC_GRIEVANCE_OFFICER_NAME=REPLACE_ME_GRIEVANCE_OFFICER_NAME
EXPO_PUBLIC_GRIEVANCE_OFFICER_EMAIL=REPLACE_ME_GRIEVANCE_OFFICER_EMAIL
EXPO_PUBLIC_GRIEVANCE_OFFICER_PHONE=REPLACE_ME_GRIEVANCE_OFFICER_PHONE
EXPO_PUBLIC_GRIEVANCE_OFFICER_ADDRESS=REPLACE_ME_GRIEVANCE_OFFICER_ADDRESS

