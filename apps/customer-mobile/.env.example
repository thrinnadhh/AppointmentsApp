# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Deployed merchant-web backend URL — used for reschedule and payment order creation.
# Do not use localhost in production mobile builds.
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-backend.example.com

# Razorpay Publishable Key ID for client checkout initialization
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
