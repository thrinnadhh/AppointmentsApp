# Environment Variables Example for AppointmentsApp

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=

# Google OAuth Configuration (Google Cloud Console -> Credentials -> OAuth 2.0 Web Client)
# Default is false (OFF). Set to true only when Google credentials and Supabase provider are active.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Admin & Security Secrets
SUPERADMIN_E2E_TOKEN=
ADMIN_SECRET=
CRON_SECRET=
DELETION_TOKEN_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Business Platform
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
GRAPH_API_VERSION=v21.0
SEND_SMS_HOOK_SECRET=
ENABLE_WHATSAPP_AUTH_HOOK=false

# Redis / Upstash
REDIS_URL=
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Notifications
NOVU_API_KEY=

# Grievance Officer Configuration (DPDPA 2023 §13 — must be replaced before production build)
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=REPLACE_ME_GRIEVANCE_OFFICER_NAME
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=REPLACE_ME_GRIEVANCE_OFFICER_EMAIL
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=REPLACE_ME_GRIEVANCE_OFFICER_PHONE
NEXT_PUBLIC_GRIEVANCE_OFFICER_ADDRESS=REPLACE_ME_GRIEVANCE_OFFICER_ADDRESS
EXPO_PUBLIC_GRIEVANCE_OFFICER_NAME=REPLACE_ME_GRIEVANCE_OFFICER_NAME
EXPO_PUBLIC_GRIEVANCE_OFFICER_EMAIL=REPLACE_ME_GRIEVANCE_OFFICER_EMAIL
EXPO_PUBLIC_GRIEVANCE_OFFICER_PHONE=REPLACE_ME_GRIEVANCE_OFFICER_PHONE
EXPO_PUBLIC_GRIEVANCE_OFFICER_ADDRESS=REPLACE_ME_GRIEVANCE_OFFICER_ADDRESS
