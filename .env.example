# Copy to .env on the Oracle VM — never commit with real values

# Supabase Postgres (Transaction mode, port 6543)
DATABASE_URL=jdbc:postgresql://db.your-project.supabase.co:6543/postgres?prepareThreshold=0

# JWT — copy from Supabase Dashboard → Settings → API → JWT Secret
JWT_SECRET=your-supabase-jwt-secret-here
JWT_ISSUER=https://your-project.supabase.co/auth/v1

# Novu notification service
NOVU_API_KEY=your-novu-api-key

# Cloudflare API token (for Caddy auto-TLS)
CF_API_TOKEN=your-cloudflare-api-token

# GitHub container registry repo path (e.g. "yourgithubuser/appointments")
GITHUB_REPO=yourgithubuser/appointments

# Admin & E2E Security Secrets
SUPERADMIN_E2E_TOKEN=your-superadmin-e2e-token-here
ADMIN_SECRET=your-admin-secret-here

# Cron Authentication Secret
CRON_SECRET=your-cron-secret-token-here

# Dedicated signing key for account-deletion proof-of-ownership tokens (vuln-0023)
# (>= 32 random characters; must NOT reuse ADMIN_SECRET or CRON_SECRET)
DELETION_TOKEN_SECRET=your-dedicated-deletion-token-secret-here


